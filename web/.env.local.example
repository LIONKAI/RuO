# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # solo servidor — nunca exponer al cliente

# Postgres para Drizzle (Project Settings → Database → Connect).
# En Vercel usa el "Transaction pooler" (puerto 6543), apto para serverless.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# Servicios externos (mismos valores que la app Laravel)
OSRM_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT=15
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RuO/1.0 (tu-email)
NOMINATIM_COUNTRY_CODES=bo
NOMINATIM_TIMEOUT=10
RUO_DEFAULT_CITY=Santa Cruz
